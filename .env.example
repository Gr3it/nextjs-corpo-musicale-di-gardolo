# Copia in .env.local e compila. Su Vercel: Settings → Environment Variables.

# Progetto Sanity (sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# URL pubblico del sito (senza / finale): usato per sitemap, link calendario e SEO
NEXT_PUBLIC_SITE_URL=https://www.bandagardolo.it

# Segreto condiviso con il webhook Sanity → /api/revalidate
SANITY_REVALIDATE_SECRET=

# Solo per lo script di migrazione (token "Editor" da sanity.io/manage → API → Tokens). Non serve su Vercel.
SANITY_WRITE_TOKEN=
